# Copiez ce fichier en .env puis adaptez les valeurs.
# Par défaut, l'application utilise SQLite (démarrage immédiat, aucune installation).

# --- MySQL (recommandé en production) ---------------------------------------
# Décommentez ces lignes et renseignez la connexion. La base doit exister :
#   CREATE DATABASE edt_universitaire CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=votre_mot_de_passe
# MYSQL_DATABASE=edt_universitaire

# --- Ou une URL SQLAlchemy complète (prioritaire sur les variables MYSQL) ---
# DATABASE_URL=mysql+pymysql://root:motdepasse@localhost:3306/edt_universitaire?charset=utf8mb4
# DATABASE_URL=sqlite:///./edt.db
# PostgreSQL (Neon, Supabase, Render…) : les URL « postgres:// » sont acceptées.
# DATABASE_URL=postgresql://utilisateur:motdepasse@hote/base?sslmode=require

# --- Sécurité ----------------------------------------------------------------
SECRET_KEY=changez-cette-cle-secrete-en-production
TOKEN_EXPIRATION_MINUTES=480

# --- CORS (interface Flutter lancée séparément) ------------------------------
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:8000,http://127.0.0.1:8000
